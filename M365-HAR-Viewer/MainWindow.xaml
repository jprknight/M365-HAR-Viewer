<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="M365_HAR_Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:M365_HAR_Viewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:tableview="using:WinUI.TableView"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d"
    Title="M365-HAR-Viewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel Orientation="Horizontal">

        <StackPanel.Resources>
            <Style TargetType="Button">
                <Setter Property="Width" Value="150"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10"/>
            </Style>

        </StackPanel.Resources>

        <StackPanel x:Name="LoadButton" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="LoadFileButton" Content="Load HAR File" Click="LoadFileButton_Click" Background="Green"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <ToggleSwitch x:Name="ToggleViewSwitch" 
                          Header="Toggle View" 
                          Margin="10"
                          Toggled="ToggleViewSwitch_Toggled"
                          Visibility="Collapsed"/>

            <controls:DataGrid 
                x:Name="SessionsDataGrid" 
                ItemsSource="{x:Bind Sessions}"
                IsReadOnly="True"
                GridLinesVisibility="All"
                AutoGenerateColumns="True"
                Visibility="Collapsed"
                CanUserSortColumns="True"
            />



        </StackPanel>

        <StackPanel>
            <ToggleSwitch x:Name="ToggleViewSwitch1" 
                    Header="Toggle View" 
                    Margin="10"
                    Toggled="ToggleViewSwitch1_Toggled"
                    Visibility="Collapsed"/>
            
        </StackPanel>
    </StackPanel>
</Window>
