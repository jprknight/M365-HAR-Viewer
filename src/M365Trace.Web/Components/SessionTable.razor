@implements IDisposable

<div class="session-panel">
    <div class="panel-heading">
        <div>
            <h2>@FileName</h2>
            <p>@TotalSessionCount.ToString("N0") sessions</p>
        </div>
        <div class="search-box-container">
            <input class="search-box"
                   type="search"
                   value="@searchText"
                   @oninput="HandleSearchInputAsync"
                   placeholder="Search URLs, headers, bodies, and findings"
                   aria-label="Search session URLs, headers, bodies, and findings" />
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button class="search-clear-button"
                        type="button"
                        title="Clear filter"
                        aria-label="Clear filter"
                        @onclick="ClearFreeTextAsync">
                    &times;
                </button>
            }
        </div>
    </div>

    <TraceFilterBar AllSessions="AllSessions"
                    Query="Query"
                    QueryChanged="QueryChanged"
                    VisibleSessionCount="Sessions.Count"
                    TotalSessionCount="TotalSessionCount"
                    ClearAllRequested="ClearAllAsync" />

    <p id="session-grid-instructions" class="visually-hidden">
        Use Up and Down Arrow keys to move between sessions, Home and End
        to move to the first or last visible session, and Right Arrow to
        move to the session details. Use Left Arrow from the details panel
        to return to the selected session.
    </p>

    <div class="table-container"
         tabindex="-1">
        <table class="session-table"
               data-session-grid
               data-session-count="@Sessions.Count"
               data-selected-index="@selectedSessionIndex"
               data-session-row-height="@SessionRowHeight"
               role="grid"
               aria-label="Trace sessions"
               aria-describedby="session-grid-instructions"
               aria-rowcount="@(Sessions.Count + 1)"
               aria-multiselectable="false">
            <thead>
                <tr>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Id)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Id)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Id)">#</button>
                    </th>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Analysis)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Analysis)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Analysis)">Analysis</button>
                    </th>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Status)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Status)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Status)">Status</button>
                    </th>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Method)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Method)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Method)">Method</button>
                    </th>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Host)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Host)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Host)">Host</button>
                    </th>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Path)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Path)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Path)">Path</button>
                    </th>
                    <th aria-sort="@GetAriaSort(SessionSortColumn.Duration)">
                        <button type="button"
                                class="@GetSortButtonClass(SessionSortColumn.Duration)"
                                @onclick="() => SortChanged.InvokeAsync(SessionSortColumn.Duration)">Duration</button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Sessions.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-filter-result">
                            No sessions match the active filters.
                        </td>
                    </tr>
                }
                else
                {
                    <Virtualize Items="@virtualizedSessions"
                                Context="row"
                                ItemSize="@SessionRowHeight"
                                OverscanCount="8"
                                SpacerElement="tr">
                        <tr @key="row.Session.Id"
                            class="@(SelectedSessionId == row.Session.Id ? "selected" : null)"
                            data-session-id="@row.Session.Id"
                            data-session-index="@row.Index"
                            data-session-row
                            tabindex="@(SelectedSessionId == row.Session.Id ? "0" : "-1")"
                            aria-rowindex="@(row.Index + 2)"
                            aria-selected="@(SelectedSessionId == row.Session.Id ? "true" : "false")"
                            aria-label="@GetSessionAccessibleLabel(row.Session)"
                            @onclick="() => SessionSelected.InvokeAsync(row.Session)">
                            <td>@row.Session.Id</td>
                            <td>
                                <span class="severity-badge @TraceDisplayFormatter.GetSeverityClass(row.Session.Analysis.Severity)">
                                    @TraceDisplayFormatter.GetSeverityLabel(row.Session.Analysis.Severity)
                                </span>
                            </td>
                            <td>
                                <span class="status-code @TraceDisplayFormatter.GetStatusClass(row.Session.StatusCode)">
                                    @row.Session.StatusCode
                                </span>
                            </td>
                            <td><span class="method">@row.Session.Method</span></td>
                            <td>@row.Session.Url.Host</td>
                            <td class="path-cell"
                                title="@row.Session.Url.PathAndQuery">@row.Session.Url.PathAndQuery</td>
                            <td>@TraceDisplayFormatter.FormatDuration(row.Session.Duration)</td>
                        </tr>
                    </Virtualize>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public string? FileName { get; set; }

    [Parameter]
    public int TotalSessionCount { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<TraceSession> AllSessions { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<TraceSession> Sessions { get; set; }

    [Parameter]
    public int? SelectedSessionId { get; set; }

    [Parameter]
    public required SessionQuery Query { get; set; }

    [Parameter]
    public EventCallback<SessionQuery> QueryChanged { get; set; }

    [Parameter]
    public EventCallback ClearAllRequested { get; set; }

    [Parameter]
    public EventCallback<SessionSortColumn> SortChanged { get; set; }

    [Parameter]
    public EventCallback<TraceSession> SessionSelected { get; set; }

    private const int SearchDebounceMilliseconds = 300;
    private const float SessionRowHeight = 43;

    private CancellationTokenSource? searchDebounce;
    private IReadOnlyList<TraceSession>? previousSessions;
    private SessionRow[] virtualizedSessions = [];
    private int selectedSessionIndex = -1;
    private string searchText = string.Empty;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previousSessions, Sessions))
        {
            virtualizedSessions = Sessions
                .Select((session, index) => new SessionRow(session, index))
                .ToArray();
            previousSessions = Sessions;
        }

        selectedSessionIndex = FindSelectedSessionIndex();

        if (searchDebounce is null)
        {
            searchText = Query.FreeText;
        }
    }

    private async Task HandleSearchInputAsync(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        CancelPendingSearch();

        var debounce = new CancellationTokenSource();
        searchDebounce = debounce;

        try
        {
            await Task.Delay(
                SearchDebounceMilliseconds,
                debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(searchDebounce, debounce))
        {
            return;
        }

        searchDebounce = null;
        debounce.Dispose();
        await QueryChanged.InvokeAsync(Query with
        {
            FreeText = searchText
        });
    }

    private async Task ClearFreeTextAsync()
    {
        CancelPendingSearch();
        searchText = string.Empty;
        await QueryChanged.InvokeAsync(Query with { FreeText = string.Empty });
    }

    private async Task ClearAllAsync()
    {
        CancelPendingSearch();
        searchText = string.Empty;
        await ClearAllRequested.InvokeAsync();
    }

    private void CancelPendingSearch()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = null;
    }

    private string GetSortButtonClass(SessionSortColumn column) =>
        Query.SortColumn == column
            ? $"sort-button active {(Query.SortAscending ? "ascending" : "descending")}"
            : "sort-button";

    private string GetAriaSort(SessionSortColumn column) =>
        Query.SortColumn != column
            ? "none"
            : Query.SortAscending
                ? "ascending"
                : "descending";

    private static string GetSessionAccessibleLabel(TraceSession session) =>
        $"Session {session.Id}, "
        + $"{TraceDisplayFormatter.GetSeverityLabel(session.Analysis.Severity)}, "
        + $"HTTP {session.StatusCode}, "
        + $"{session.Method} {session.Url.Host}{session.Url.PathAndQuery}, "
        + $"{TraceDisplayFormatter.FormatDuration(session.Duration)}";

    private int FindSelectedSessionIndex()
    {
        if (SelectedSessionId is not int selectedSessionId)
        {
            return -1;
        }

        for (var index = 0; index < Sessions.Count; index++)
        {
            if (Sessions[index].Id == selectedSessionId)
            {
                return index;
            }
        }

        return -1;
    }

    public void Dispose() => CancelPendingSearch();

    private readonly record struct SessionRow(
        TraceSession Session,
        int Index);
}
