@page "/"
@using System.Diagnostics
@using M365Trace.Web.Services.Telemetry
@inject IEnumerable<ITraceImporter> TraceImporters
@inject TraceAnalysisEngine AnalysisEngine
@inject M365Trace.Web.Services.VersionUpdateService VersionUpdateService
@inject M365Trace.Web.Services.SessionQueryService SessionQueryService
@inject M365Trace.Web.Services.TraceSummaryService TraceSummaryService
@inject M365Trace.Web.Services.TraceOperationCoordinator OperationCoordinator
@inject IUsageTelemetryService UsageTelemetry

<PageTitle>M365 Trace Analyzer</PageTitle>

<header class="app-header">
    <div>
        <p class="eyebrow">Microsoft 365 Diagnostics</p>
        <h1>M365 Trace Analyzer</h1>
        <p class="subtitle">Analyze HTTP Archive files locally. Trace data is processed by this application and is not uploaded to an external service.</p>
    </div>

    <div class="header-actions">
        <div class="version-card @GetVersionStatusClass()"
             title="@versionCheck?.Detail">
            <span>Version @VersionUpdateService.CurrentVersion</span>
            @if (isLoading)
            {
                <div class="trace-operation-inline"
                     role="status"
                     aria-live="polite">
                    <strong>@operationStatus</strong>
                    <button type="button"
                            @onclick="CancelActiveOperation">
                        Cancel
                    </button>
                </div>
            }
            else if (versionCheck is null)
            {
                <strong>Checking for updates...</strong>
            }
            else if (versionCheck.State == M365Trace.Web.Services.VersionCheckState.UpdateAvailable)
            {
                @if (versionCheck.ReleaseUri is not null)
                {
                    <a href="@versionCheck.ReleaseUri"
                       target="_blank"
                       rel="noopener noreferrer">
                        Version @versionCheck.LatestVersion available
                    </a>
                }
                else
                {
                    <strong>Version @versionCheck.LatestVersion available</strong>
                }
            }
            else
            {
                <strong>@GetVersionStatusText()</strong>
            }
        </div>

        @if (UsageTelemetry.IsAvailable)
        {
            <button type="button"
                    class="telemetry-settings-button"
                    @onclick="ToggleTelemetrySettings">
                Telemetry: @GetTelemetryStatusText()
            </button>
        }

        <label class="file-button">
            <span>@(isLoading ? "Open Another Trace" : "Open Trace")</span>
            <InputFile OnChange="LoadTraceAsync"
                       accept=".har,.saz,application/json,application/zip" />
        </label>
    </div>
</header>

@if (UsageTelemetry.IsAvailable
    && UsageTelemetry.Consent == TelemetryConsent.Unknown)
{
    <dialog class="telemetry-consent-dialog"
            data-telemetry-consent
            aria-labelledby="telemetry-consent-heading"
            aria-describedby="telemetry-consent-description">
        <section class="telemetry-consent-card">
            <div>
                <p class="eyebrow">Privacy choice required</p>
                <h2 id="telemetry-consent-heading">
                    Share anonymous usage telemetry?
                </h2>
                <p id="telemetry-consent-description">
                    Help improve M365 Trace Analyzer by sharing app version,
                    operating-system family, anonymous application sessions,
                    country derived by Application Insights, and coarse trace
                    import outcomes.
                </p>
                <p>
                    Trace names, paths, URLs, hosts, headers, bodies, findings,
                    account details, and device identifiers are never
                    collected. Trace processing remains local whether you
                    choose Yes or No.
                </p>
                <a class="telemetry-privacy-link"
                   href="https://github.com/jprknight/M365-Trace-Analyzer/blob/master/docs/USAGE-TELEMETRY.md"
                   target="_blank"
                   rel="noopener noreferrer">
                    Review the telemetry privacy details
                </a>
                @if (!string.IsNullOrWhiteSpace(telemetrySettingsError))
                {
                    <p class="telemetry-settings-error" role="alert">
                        @telemetrySettingsError
                    </p>
                }
            </div>
            <div class="telemetry-consent-actions">
                <button type="button"
                        class="primary-button"
                        @onclick="EnableTelemetryAsync">
                    Yes, share anonymous usage
                </button>
                <button type="button"
                        class="secondary-action-button"
                        @onclick="DisableTelemetryAsync">
                    No, do not share
                </button>
            </div>
        </section>
    </dialog>
}

@if (UsageTelemetry.IsAvailable
    && UsageTelemetry.Consent != TelemetryConsent.Unknown
    && showTelemetrySettings)
{
    <section class="telemetry-settings-panel"
             aria-labelledby="telemetry-settings-heading">
        <div>
            <p class="eyebrow">Optional product analytics</p>
            <h2 id="telemetry-settings-heading">Anonymous usage telemetry</h2>
            <p>
                Trace names, paths, URLs, hosts, headers, bodies, findings,
                account details, and device identifiers are never collected.
            </p>
            <a class="telemetry-privacy-link"
               href="https://github.com/jprknight/M365-Trace-Analyzer/blob/master/docs/USAGE-TELEMETRY.md"
               target="_blank"
               rel="noopener noreferrer">
                Review the telemetry privacy details
            </a>
            @if (!string.IsNullOrWhiteSpace(telemetrySettingsError))
            {
                <p class="telemetry-settings-error" role="alert">
                    @telemetrySettingsError
                </p>
            }
        </div>
        <div class="telemetry-consent-actions">
            @if (UsageTelemetry.Consent == TelemetryConsent.Enabled)
            {
                <strong class="telemetry-enabled">Telemetry is on</strong>
                <button type="button"
                        class="secondary-action-button"
                        @onclick="ResetTelemetryIdAsync">
                    Reset anonymous ID
                </button>
                <button type="button"
                        class="secondary-action-button"
                        @onclick="DisableTelemetryAsync">
                    Turn off
                </button>
            }
            else
            {
                <strong>Telemetry is off</strong>
                <button type="button"
                        class="primary-button"
                        @onclick="EnableTelemetryAsync">
                    Turn on
                </button>
            }

            <button type="button"
                    class="secondary-action-button"
                    @onclick="CloseTelemetrySettings">
                Close
            </button>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="message error-message" role="alert">
        <strong>Unable to open the trace.</strong>
        <span>@errorMessage</span>
    </div>
}

@if (pendingFile is not null)
{
    <section class="password-prompt" aria-labelledby="password-prompt-heading">
        <div>
            <p class="eyebrow">Encrypted SAZ archive</p>
            <h2 id="password-prompt-heading">Password required</h2>
            <p>Enter the password for <strong>@pendingFile.Name</strong>. The password is used only to decrypt this import and is not saved.</p>
        </div>
        <form @onsubmit="RetryEncryptedSazAsync" @onsubmit:preventDefault>
            <input type="password"
                   class="password-input"
                   placeholder="SAZ password"
                   aria-label="SAZ archive password"
                   autocomplete="current-password"
                   @bind="archivePassword"
                   @bind:event="oninput" />
            <button type="submit"
                    class="primary-button"
                    disabled="@(isLoading || string.IsNullOrEmpty(archivePassword))">
                @(isLoading ? "Opening..." : "Open archive")
            </button>
            <button type="button"
                    class="secondary-action-button"
                    disabled="@isLoading"
                    @onclick="CancelPasswordPrompt">Cancel</button>
        </form>
    </section>
}

@if (workspace.Sessions.Count == 0 && pendingFile is null)
{
    <section class="empty-state">
        @if (isLoading)
        {
            <h2>@operationStatus</h2>
            <p>You can cancel this operation or open another trace from the header.</p>
        }
        else
        {
            <label class="file-button empty-file-button">
                <span>Open Trace</span>
                <InputFile OnChange="LoadTraceAsync"
                           accept=".har,.saz,application/json,application/zip" />
            </label>
            <h2>Open a HAR or SAZ trace</h2>
            <p>Select a HAR file exported from browser developer tools or a Fiddler Session Archive.</p>
        }
    </section>
}
else if (workspace.Sessions.Count > 0)
{
    @if (importResult is not null
        && (importResult.Quality.HasWarnings || importResult.Issues.Count > 0))
    {
        <ImportQualityBanner Result="importResult" />
    }

    @if (traceSummary is not null)
    {
        <TraceSummaryPanel Summary="traceSummary"
                           VisibleSessionCount="workspace.VisibleSessions.Count"
                           ClearAllRequested="ClearAllFilters"
                           SeveritySelected="ApplySeverityFilter"
                           StatusSelected="ApplyStatusFilter"
                           FindingsSelected="ApplyFindingsFilter"
                           HostSelected="ApplyHostFilter"
                           FindingSelected="ApplyFindingFilter"
                           AuthenticationSelected="ApplyAuthenticationFilter"
                           SessionSelected="SelectSessionById" />
    }

    <section class="workspace">
        <SessionTable FileName="@workspace.FileName"
                      TotalSessionCount="workspace.Sessions.Count"
                      AllSessions="workspace.Sessions"
                      Sessions="FilteredSessions"
                      SelectedSessionId="workspace.SelectedSession?.Id"
                      Query="workspace.Query"
                      QueryChanged="SetQuery"
                      ClearAllRequested="ClearAllFilters"
                      SortChanged="SetSort"
                      SessionSelected="SelectSession" />
        <SessionDetailPanel Session="workspace.SelectedSession"
                            TrafficView="trafficView"
                            TrafficViewChanged="SetTrafficView" />
    </section>
}

@code {
    private const long MaximumBrowserFileSize = HarImportOptions.DefaultMaximumFileSize;

    private M365Trace.Web.Services.TraceWorkspaceState workspace = null!;
    private M365Trace.Web.Services.TraceSummary? traceSummary;
    private TraceImportResult? importResult;
    private string? errorMessage;
    private string archivePassword = string.Empty;
    private string? operationStatus;
    private IBrowserFile? pendingFile;
    private ITraceImporter? pendingImporter;
    private M365Trace.Web.Services.VersionCheckResult? versionCheck;
    private DetailTrafficView trafficView = DetailTrafficView.Both;
    private bool showTelemetrySettings;
    private string? telemetrySettingsError;

    private bool isLoading => OperationCoordinator.HasActiveOperation;

    protected override async Task OnInitializedAsync()
    {
        workspace = new M365Trace.Web.Services.TraceWorkspaceState(
            SessionQueryService);
        versionCheck = await VersionUpdateService.CheckForUpdatesAsync();
    }

    private IReadOnlyList<TraceSession> FilteredSessions =>
        workspace.VisibleSessions;

    private void SetSort(M365Trace.Web.Services.SessionSortColumn column)
    {
        workspace.SetSort(column);
    }

    private void SetQuery(M365Trace.Web.Services.SessionQuery query) =>
        workspace.SetQuery(query);

    private void ClearAllFilters() => workspace.ClearAllFilters();

    private void ApplySeverityFilter(
        M365Trace.Web.Services.TraceSeverityFilter severity) =>
        workspace.SetQuery(workspace.Query with { Severities = [severity] });

    private void ApplyStatusFilter(
        M365Trace.Web.Services.TraceStatusFamily status) =>
        workspace.SetQuery(workspace.Query with
        {
            StatusFamilies = [status],
            StatusCodes = []
        });

    private void ApplyFindingsFilter(
        M365Trace.Web.Services.SessionFindingFilter findings) =>
        workspace.SetQuery(workspace.Query with { Findings = findings });

    private void ApplyHostFilter(string host) =>
        workspace.SetQuery(workspace.Query with { Hosts = [host] });

    private void ApplyFindingFilter(string ruleId) =>
        workspace.SetQuery(workspace.Query with
        {
            FindingRuleIds = [ruleId]
        });

    private void ApplyAuthenticationFilter(string authentication) =>
        workspace.SetQuery(workspace.Query with
        {
            Authentications = [authentication]
        });

    private void SelectSessionById(int sessionId)
    {
        workspace.ClearAllFilters();
        var session = workspace.Sessions.FirstOrDefault(candidate =>
            candidate.Id == sessionId);
        if (session is not null)
        {
            workspace.SelectSession(session);
        }
    }

    private void SetTrafficView(DetailTrafficView view) => trafficView = view;

    private async Task LoadTraceAsync(InputFileChangeEventArgs args)
    {
        var telemetryStartedAt = Stopwatch.GetTimestamp();
        var operation = OperationCoordinator.Begin();
        operationStatus = $"Opening {args.File.Name}...";
        errorMessage = null;
        archivePassword = string.Empty;
        pendingFile = null;
        pendingImporter = null;

        var file = args.File;
        ITraceImporter? importer = null;

        try
        {
            importer = TraceImporters.FirstOrDefault(candidate =>
                candidate.CanImport(file.Name))
                ?? throw new TraceImportException(
                    "Select a supported .har or .saz trace file.");
            await ImportTraceAsync(
                file,
                importer,
                operation,
                telemetryStartedAt,
                encrypted: false);
        }
        catch (SazPasswordRequiredException)
        {
            if (OperationCoordinator.IsCurrent(operation))
            {
                pendingFile = file;
                pendingImporter = importer!;
            }
        }
        catch (OperationCanceledException)
            when (operation.CancellationToken.IsCancellationRequested)
        {
            TrackImportOutcome(
                file,
                encrypted: false,
                UsageTraceImportOutcome.Cancelled,
                telemetryStartedAt);
        }
        catch (Exception exception) when (
            exception is TraceImportException
            or IOException
            or InvalidOperationException)
        {
            if (OperationCoordinator.IsCurrent(operation))
            {
                errorMessage = exception.Message;
            }

            TrackImportOutcome(
                file,
                encrypted: false,
                UsageTraceImportOutcome.Failed,
                telemetryStartedAt,
                error: GetTelemetryError(exception));
        }
        finally
        {
            if (OperationCoordinator.Complete(operation))
            {
                operationStatus = null;
            }
        }
    }

    private async Task RetryEncryptedSazAsync()
    {
        if (pendingFile is null
            || pendingImporter is null
            || string.IsNullOrEmpty(archivePassword))
        {
            return;
        }

        var telemetryStartedAt = Stopwatch.GetTimestamp();
        var file = pendingFile;
        var importer = pendingImporter;
        var operation = OperationCoordinator.Begin();
        operationStatus = $"Opening {file.Name}...";
        errorMessage = null;
        var password = archivePassword;
        archivePassword = string.Empty;

        try
        {
            await ImportTraceAsync(
                file,
                importer,
                operation,
                telemetryStartedAt,
                encrypted: true,
                options: new TraceImportOptions { Password = password });
        }
        catch (OperationCanceledException)
            when (operation.CancellationToken.IsCancellationRequested)
        {
            TrackImportOutcome(
                file,
                encrypted: true,
                UsageTraceImportOutcome.Cancelled,
                telemetryStartedAt);
        }
        catch (Exception exception) when (
            exception is TraceImportException
            or IOException
            or InvalidOperationException)
        {
            if (OperationCoordinator.IsCurrent(operation))
            {
                errorMessage = exception.Message;
            }

            TrackImportOutcome(
                file,
                encrypted: true,
                UsageTraceImportOutcome.Failed,
                telemetryStartedAt,
                error: GetTelemetryError(exception));
        }
        finally
        {
            if (OperationCoordinator.Complete(operation))
            {
                operationStatus = null;
            }
        }
    }

    private async Task ImportTraceAsync(
        IBrowserFile file,
        ITraceImporter importer,
        M365Trace.Web.Services.TraceOperation operation,
        long telemetryStartedAt,
        bool encrypted,
        TraceImportOptions? options = null)
    {
        var cancellationToken = operation.CancellationToken;
        await using var stream = file.OpenReadStream(MaximumBrowserFileSize);
        var result = await importer.ImportWithReportAsync(
            stream,
            options,
            cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();

        await UpdateOperationStatusAsync(
            operation,
            $"Analyzing {result.Sessions.Count:N0} sessions...");
        var analyzedSessions = await Task.Run(
            () => AnalyzeSessions(result.Sessions, cancellationToken),
            cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();

        await UpdateOperationStatusAsync(operation, "Preparing workspace...");
        var summary = await Task.Run(
            () => TraceSummaryService.Create(
                analyzedSessions,
                cancellationToken),
            cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        if (!OperationCoordinator.IsCurrent(operation))
        {
            TrackImportOutcome(
                file,
                encrypted,
                UsageTraceImportOutcome.Cancelled,
                telemetryStartedAt);
            return;
        }

        workspace.ReplaceSessions(file.Name, analyzedSessions);
        importResult = result;
        traceSummary = summary;
        pendingFile = null;
        pendingImporter = null;
        TrackImportOutcome(
            file,
            encrypted,
            result.Quality.HasWarnings
                ? UsageTraceImportOutcome.Partial
                : UsageTraceImportOutcome.Complete,
            telemetryStartedAt,
            result.Sessions.Count);
    }

    private TraceSession[] AnalyzeSessions(
        IReadOnlyList<TraceSession> sessions,
        CancellationToken cancellationToken)
    {
        var analyzed = new TraceSession[sessions.Count];
        for (var index = 0; index < sessions.Count; index++)
        {
            cancellationToken.ThrowIfCancellationRequested();
            var session = sessions[index];
            analyzed[index] = session with
            {
                Analysis = AnalysisEngine.Analyze(
                    session,
                    cancellationToken)
            };
        }

        return analyzed;
    }

    private async Task UpdateOperationStatusAsync(
        M365Trace.Web.Services.TraceOperation operation,
        string status)
    {
        if (!OperationCoordinator.IsCurrent(operation))
        {
            return;
        }

        operationStatus = status;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelActiveOperation()
    {
        if (OperationCoordinator.CancelCurrent())
        {
            operationStatus = "Cancelling...";
        }
    }

    private void CancelPasswordPrompt()
    {
        archivePassword = string.Empty;
        pendingFile = null;
        pendingImporter = null;
        errorMessage = null;
    }

    private void ToggleTelemetrySettings()
    {
        telemetrySettingsError = null;
        showTelemetrySettings = !showTelemetrySettings;
    }

    private void CloseTelemetrySettings()
    {
        telemetrySettingsError = null;
        showTelemetrySettings = false;
    }

    private Task EnableTelemetryAsync() =>
        SetTelemetryConsentAsync(TelemetryConsent.Enabled);

    private Task DisableTelemetryAsync() =>
        SetTelemetryConsentAsync(TelemetryConsent.Disabled);

    private async Task SetTelemetryConsentAsync(TelemetryConsent consent)
    {
        telemetrySettingsError = null;
        try
        {
            await UsageTelemetry.SetConsentAsync(consent);
            showTelemetrySettings = false;
        }
        catch (Exception exception) when (
            exception is IOException
            or UnauthorizedAccessException
            or InvalidOperationException)
        {
            telemetrySettingsError =
                "The telemetry preference could not be saved.";
        }
    }

    private async Task ResetTelemetryIdAsync()
    {
        telemetrySettingsError = null;
        try
        {
            await UsageTelemetry.ResetInstallationIdAsync();
        }
        catch (Exception exception) when (
            exception is IOException
            or UnauthorizedAccessException
            or InvalidOperationException)
        {
            telemetrySettingsError =
                "The anonymous installation ID could not be reset.";
        }
    }

    private void TrackImportOutcome(
        IBrowserFile file,
        bool encrypted,
        UsageTraceImportOutcome outcome,
        long startedAt,
        int? sessionCount = null,
        UsageTraceImportError error = UsageTraceImportError.None)
    {
        UsageTelemetry.TrackTraceImportCompleted(
            GetUsageTraceFormat(file.Name),
            encrypted,
            outcome,
            sessionCount,
            Stopwatch.GetElapsedTime(startedAt),
            error);
    }

    private static UsageTraceFormat GetUsageTraceFormat(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".har" => UsageTraceFormat.Har,
            ".saz" => UsageTraceFormat.Saz,
            _ => UsageTraceFormat.Unknown
        };

    private static UsageTraceImportError GetTelemetryError(
        Exception exception) =>
        exception switch
        {
            SazInvalidPasswordException =>
                UsageTraceImportError.PasswordIncorrect,
            TraceImportException => UsageTraceImportError.ImportRejected,
            IOException => UsageTraceImportError.IoError,
            InvalidOperationException =>
                UsageTraceImportError.InvalidOperation,
            _ => UsageTraceImportError.InvalidOperation
        };

    private string GetTelemetryStatusText() =>
        UsageTelemetry.Consent switch
        {
            TelemetryConsent.Enabled => "On",
            TelemetryConsent.Disabled => "Off",
            _ => "Review"
        };

    private void SelectSession(TraceSession session)
    {
        workspace.SelectSession(session);
    }

    private string GetVersionStatusClass() => versionCheck?.State switch
    {
        M365Trace.Web.Services.VersionCheckState.Latest => "version-latest",
        M365Trace.Web.Services.VersionCheckState.UpdateAvailable => "version-update",
        M365Trace.Web.Services.VersionCheckState.NoPublishedRelease => "version-no-release",
        M365Trace.Web.Services.VersionCheckState.Unavailable => "version-unavailable",
        _ => "version-checking"
    };

    private string GetVersionStatusText() => versionCheck?.State switch
    {
        M365Trace.Web.Services.VersionCheckState.Latest =>
            "Latest available version",
        M365Trace.Web.Services.VersionCheckState.NoPublishedRelease =>
            "No published release yet",
        M365Trace.Web.Services.VersionCheckState.Unavailable =>
            "Update check unavailable",
        _ => "Checking for updates..."
    };

}
